<Window x:Class="ApexToolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apex Toolbox"
        Width="1200" Height="800" MinWidth="1040" MinHeight="680"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="A" FontSize="19" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="APEX TOOLBOX" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="画面设置 · 配置导入 · 备份还原" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PathStatusText" Text="正在检测配置目录…"
                               Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Margin="0,0,12,0" MaxWidth="380" TextTrimming="CharacterEllipsis" />
                    <Button Content="选择目录" Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0" Click="BrowseFolder_Click" />
                    <Button Content="打开目录" Style="{StaticResource GhostButton}" Click="OpenFolder_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#101318"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,10">
                        <TextBlock Text="修改前自动备份" Style="{StaticResource Caption}" />
                        <TextBlock Text="v1.0.0" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <RadioButton x:Name="NavPreset" Content="玩家设置" Style="{StaticResource NavItem}"
                                     GroupName="Nav" Tag="preset" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavImport" Content="导入与导出" Style="{StaticResource NavItem}"
                                     GroupName="Nav" Tag="import" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavBackup" Content="备份还原" Style="{StaticResource NavItem}"
                                     GroupName="Nav" Tag="backup" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavLaunch" Content="启动参数" Style="{StaticResource NavItem}"
                                     GroupName="Nav" Tag="launch" Checked="Nav_Checked" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <!-- 玩家设置 -->
                <ScrollViewer x:Name="PagePreset" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,18">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="玩家设置" Style="{StaticResource H2}" />
                                    <TextBlock Text="配置内容来自远端数据源，本地保存一份缓存；点击「更新」手动拉取最新内容。"
                                               Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                    <TextBlock x:Name="PresetSourceText" Style="{StaticResource Caption}"
                                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button x:Name="PresetUpdateButton" Grid.Column="1" Content="更新"
                                        Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                        Click="UpdatePresets_Click" />
                            </Grid>
                        </Border>
                        <ItemsControl x:Name="PresetItemsHost">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="64" Height="64" CornerRadius="32">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#E23B2E" Offset="0" />
                                                            <GradientStop Color="#7A1B14" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding Initial}" FontSize="28" FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" />
                                                    <TextBlock Text="{Binding EntryCount, StringFormat='共 {0} 项设置'}"
                                                               Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                <Button Content="一键使用" Style="{StaticResource PrimaryButton}"
                                                        Padding="14,7" Tag="{Binding}" Click="ApplyPreset_Click" />
                                                <Button Content="详情" Style="{StaticResource GhostButton}"
                                                        Margin="8,0,0,0" Tag="{Binding}" Click="PresetDetail_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 玩家配置详情 -->
                <ScrollViewer x:Name="PagePresetDetail" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,18">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="DetailTitleText" Style="{StaticResource H2}" />
                                    <TextBlock x:Name="DetailSubText" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="← 返回" Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Center" Click="PresetBack_Click" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="cfg 文件内容" Style="{StaticResource H2}" />
                                <TextBlock Text="按该玩家的配置生成的 videoconfig 内容，可直接对照游戏文件。"
                                           Style="{StaticResource Caption}" Margin="0,4,0,10" />
                                <TextBox x:Name="DetailCfgBox" Style="{StaticResource DarkTextBox}" Height="240"
                                         IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="每条设置改了什么" Style="{StaticResource H2}" />
                                <ItemsControl x:Name="DetailItemsHost" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource RowBorder}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource Caption}" FontFamily="Consolas" Margin="0,3,0,0">
                                                            <Run Text="{Binding Key}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding TargetText}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}"
                                                                   TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="620" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="16,0,0,0">
                                                        <TextBlock Text="{Binding CurrentDisplay}" Style="{StaticResource Caption}"
                                                                   FontFamily="Consolas" VerticalAlignment="Center" />
                                                        <TextBlock Text=" → " Foreground="{StaticResource MutedBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Value}" Style="{StaticResource Body}"
                                                                   FontFamily="Consolas" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 导入与导出 -->
                <ScrollViewer x:Name="PageImport" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,18">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="导入他人配置" Style="{StaticResource H2}" />
                                <TextBlock Text="支持 settings.cfg / videoconfig.txt，也可以直接粘贴 APX1- 分享码。分享码含完整文件原文，应用时会按原格式整文件写入。"
                                           Style="{StaticResource Caption}" Margin="0,4,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="选择配置文件" Style="{StaticResource GhostButton}" Click="ChooseImportFile_Click" />
                                    <Button Content="解析粘贴内容" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ParsePasted_Click" />
                                    <Button Content="清空" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ClearImport_Click" />
                                </StackPanel>
                                <TextBox x:Name="ImportTextBox" Style="{StaticResource DarkTextBox}" Height="140"
                                         Margin="0,12,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                                <TextBlock x:Name="ImportSummaryText" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                           Text="尚未导入内容。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="变更预览" Style="{StaticResource H2}" />
                                <ItemsControl x:Name="DiffItemsHost" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource RowBorder}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Key}" Style="{StaticResource Caption}"
                                                                   FontFamily="Consolas" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}"
                                                                   TextWrapping="Wrap" Margin="0,3,0,0" MaxWidth="520" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Caption}" />
                                                            <TextBlock Text=" · " Style="{StaticResource Caption}" />
                                                            <TextBlock Text="{Binding TargetText}" Style="{StaticResource Caption}" />
                                                            <TextBlock Text=" · " Style="{StaticResource Caption}" />
                                                            <TextBlock Text="{Binding ChangeText}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ChangeText}" Value="新增">
                                                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ChangeText}" Value="修改">
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="16,0,0,0">
                                                        <TextBlock Text="{Binding CurrentDisplay}" Style="{StaticResource Caption}"
                                                                   FontFamily="Consolas" VerticalAlignment="Center" />
                                                        <TextBlock Text=" → " Foreground="{StaticResource MutedBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding NewValue}" Style="{StaticResource Body}"
                                                                   FontFamily="Consolas" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <RadioButton x:Name="ImportVideoOnly" Content="仅导入画面相关项（推荐）"
                                                 GroupName="ImportMode" IsChecked="True" Foreground="{StaticResource TextBrush}" />
                                    <RadioButton x:Name="ImportAll" Content="全量导入" GroupName="ImportMode"
                                                 Margin="20,0,0,0" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                                <Button Content="应用变更" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0" Click="ApplyImport_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="导出与分享" Style="{StaticResource H2}" />
                                <TextBlock Text="保存或分享的都是完整配置文件：settings.cfg 与 videoconfig.txt 的全部内容、注释、顺序和编码都会保留。"
                                           Style="{StaticResource Caption}" Margin="0,4,0,12" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <Button Content="保存我的画面配置" Style="{StaticResource GhostButton}" Click="ExportFile_Click" />
                                    <Button Content="生成分享码" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="GenerateCode_Click" />
                                    <Button Content="复制" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="CopyCode_Click" />
                                </StackPanel>
                                <TextBox x:Name="ShareCodeBox" Style="{StaticResource DarkTextBox}" Height="70"
                                         Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 备份还原 -->
                <ScrollViewer x:Name="PageBackup" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,18">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="文件保护" Style="{StaticResource H2}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="设为只读，防止游戏启动时覆盖配置" Style="{StaticResource Body}" />
                                        <TextBlock Text="需要再次修改时请先关闭此开关。" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <ToggleButton x:Name="ReadOnlySwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center" Checked="ReadOnly_Checked" Unchecked="ReadOnly_Checked" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="备份记录" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="刷新" Style="{StaticResource GhostButton}" Click="RefreshBackups_Click" />
                                        <Button Content="打开目录" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OpenBackupFolder_Click" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl x:Name="BackupItemsHost" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource RowBorder}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayTime}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}" />
                                                        <TextBlock Text="{Binding Files}" Style="{StaticResource Caption}" />
                                                        <TextBlock Text="{Binding DisplaySize}" Style="{StaticResource Caption}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="还原" Style="{StaticResource GhostButton}" Tag="{Binding}" Click="RestoreBackup_Click" />
                                                        <Button Content="删除" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Tag="{Binding}" Click="DeleteBackup_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 启动参数 -->
                <ScrollViewer x:Name="PageLaunch" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,18">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="启动参数" Style="{StaticResource H2}" />
                                <TextBlock Text="点击任意一行即可复制该参数，粘贴到 Steam / EA App 的启动选项。需要多个参数时分别复制后拼接。参数效果以游戏当前版本为准。"
                                           Style="{StaticResource Caption}" Margin="0,4,0,12" />
                                <ItemsControl x:Name="LaunchItemsHost">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" Margin="2,6,0,8" />
                                                <ItemsControl ItemsSource="{Binding Options}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="3" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource LaunchItemButton}" Tag="{Binding}"
                                                                    Margin="0,0,8,8" Click="LaunchItem_Click" ToolTip="点击复制到剪贴板">
                                                                <StackPanel>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="1" Text="复制" Style="{StaticResource Caption}"
                                                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding Arg}" Style="{StaticResource Caption}"
                                                                               Foreground="{StaticResource WarnBrush}"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                                               Margin="0,4,0,0" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 底部 -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
            <DockPanel Margin="20,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="应用修改" Style="{StaticResource PrimaryButton}" Click="Apply_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Text="就绪。" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
